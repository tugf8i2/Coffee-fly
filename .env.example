# Puerto de PostgreSQL disponible desde el PC.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=coffeefly
POSTGRES_USER=postgres
# Puerto de FastAPI publicado por Docker (8000 normalmente).
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
POSTGRES_PASSWORD=1234
# Usa production fuera de desarrollo local. En ese caso define también los
# dominios/hosts reales en CORS_ORIGINS y ALLOWED_HOSTS.
ENV=development
# Opcional en desarrollo. En producción reemplázala por una clave aleatoria privada.
JWT_SECRET_KEY=coffee-fly-development-only-jwt-secret-2026-change-production
BOOTSTRAP_REGISTRADOR_EMAIL=admin@coffeefly.com
BOOTSTRAP_REGISTRADOR_PASSWORD=Admin123
# Días que se conservan los mensajes de novedades del trayecto.
EVENT_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:8080
# Desarrollo/LAN: *. Producción: el dominio real, sin http://.
ALLOWED_HOSTS=*

# En Docker web conserva /api: evita depender de localhost o de una IP fija.
EXPO_PUBLIC_API_URL=/api

# Estilo MapLibre servido por infraestructura propia de Coffee Fly, por ejemplo
# https://mapas.midominio.com/maps/styles/coffee-fly/style.json. Es obligatorio
# para habilitar la descarga regional en la app movil. No apuntes
# esta variable a tile.openstreetmap.org ni a una instancia publica que no
# autorice descargas offline.
EXPO_PUBLIC_OFFLINE_MAP_STYLE_URL=
EXPO_PUBLIC_OFFLINE_MAP_CORRIDOR_KM=5
EXPO_PUBLIC_OFFLINE_MAP_SEGMENT_KM=20
EXPO_PUBLIC_OFFLINE_MAP_MIN_ZOOM=9
EXPO_PUBLIC_OFFLINE_MAP_MAX_ZOOM=16
EXPO_PUBLIC_OFFLINE_MAP_TILE_LIMIT=30000
EXPO_PUBLIC_OFFLINE_MAP_ESTIMATED_TILE_KB=25
EXPO_PUBLIC_OFFLINE_MAP_MIN_FREE_MB=250
TILESERVER_HOST_PORT=8081
TILESERVER_ALLOWED_HOSTS=*
TILESERVER_DATA_DIR=./infra/tiles/data
# URL publica canonica, incluida la ruta /maps/ del proxy. En produccion usa
# HTTPS y el dominio real para evitar URLs envenenadas por el encabezado Host.
TILESERVER_PUBLIC_URL=http://localhost:8080/maps/

# Servicio opcional de rutas nacionales autohospedado.
OSRM_HOST_PORT=5000
OSRM_THREADS=4

# Motor de rutas. El compose principal conserva OSRM público sólo para
# desarrollo; en despliegue usa uno de los overrides autohospedados.
ROUTING_PROVIDER=osrm
ROUTING_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=12
VALHALLA_HOST_PORT=8002
VALHALLA_THREADS=4
