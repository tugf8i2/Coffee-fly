# Puerto de PostgreSQL disponible desde el PC.
POSTGRES_HOST_PORT=5433
# Puerto de FastAPI publicado por Docker (8000 normalmente).
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
POSTGRES_PASSWORD=1234
# Usa production fuera de desarrollo local. En ese caso define también los
# dominios/hosts reales en CORS_ORIGINS y ALLOWED_HOSTS.
ENV=development
# Opcional en desarrollo. En producción reemplázala por una clave aleatoria privada.
JWT_SECRET_KEY=coffee-fly-development-only-jwt-secret-2026-change-production
BOOTSTRAP_REGISTRADOR_EMAIL=admin@coffeefly.com
BOOTSTRAP_REGISTRADOR_PASSWORD=Admin123
# Días que se conservan los mensajes de novedades del trayecto.
EVENT_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:8080
# Desarrollo/LAN: *. Producción: el dominio real, sin http://.
ALLOWED_HOSTS=*

# En Docker web conserva /api: evita depender de localhost o de una IP fija.
EXPO_PUBLIC_API_URL=/api
