# Puerto de PostgreSQL disponible desde el PC.
POSTGRES_HOST_PORT=5433
# Puerto de FastAPI publicado por Docker (8000 normalmente).
BACKEND_HOST_PORT=8000
POSTGRES_PASSWORD=1234
# Opcional en desarrollo. En producción reemplázala por una clave aleatoria privada.
JWT_SECRET_KEY=coffee-fly-development-only-jwt-secret-2026-change-production
BOOTSTRAP_REGISTRADOR_EMAIL=admin@coffeefly.com
BOOTSTRAP_REGISTRADOR_PASSWORD=Admin123

# URL de la API incluida en la compilación web de Expo.
EXPO_PUBLIC_API_URL=http://localhost:8000
