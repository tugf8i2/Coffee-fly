{
  "expo": {
    "name": "Coffee Fly",
    "slug": "coffee-fly",
    "scheme": "coffee-fly",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#001c17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coffeefly.mobile",
      "infoPlist": {
        "NSLocationAlwaysUsageDescription": "Coffee Fly registra la ruta del vehículo durante una entrega activa.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.coffeefly.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Coffee Fly usa tu ubicación precisa durante una entrega activa.",
          "locationAlwaysAndWhenInUsePermission": "Coffee Fly registra la ruta del vehículo durante una entrega, incluso con la pantalla apagada.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-sensors",
        {
          "motionPermission": "Coffee Fly usa el movimiento y la orientación del dispositivo para mejorar el rumbo durante la navegación."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Coffee Fly accede a tus fotos para adjuntar evidencias y registrar el vehículo.",
          "cameraPermission": "Coffee Fly usa la cámara para fotografiar novedades del vehículo.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/brand/login-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#001c17",
          "imageWidth": 240
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],

    "extra": {
      "eas": {
        "projectId": "a09e0e55-6fef-4fc6-889c-f4e3c634a181"
      }
    },
    "owner": "tugf8i2"
  }
}
