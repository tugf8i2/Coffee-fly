# Export web con Docker/Nginx: usa el proxy interno, sin IP fija.
EXPO_PUBLIC_API_URL=/api

# Para Expo Go o un APK nativo, reemplaza /api por una URL alcanzable desde
# el teléfono, por ejemplo http://192.168.1.20:8000 o https://api.midominio.com.
# Un APK de producción debe usar HTTPS estable; no localhost ni un túnel temporal.

# Vacío usa temporalmente el demo público de OSRM. En móvil/LAN usa una URL
# alcanzable mediante el proxy, por ejemplo http://192.168.1.20:8080/osrm. En
# Docker web usa /osrm. No expongas directamente el puerto interno 5000.
EXPO_PUBLIC_OSRM_URL=

# URL HTTPS alcanzable desde el telefono hacia el estilo incluido, por ejemplo
# https://mapas.midominio.com/maps/styles/coffee-fly/style.json.
# El estilo y todas sus fuentes, sprites y fuentes tipograficas deben ser
# descargables desde ese host. Sin esta URL la app conserva ruta/GPS offline,
# pero bloquea deliberadamente la descarga automatizada de mapas publicos.
EXPO_PUBLIC_OFFLINE_MAP_STYLE_URL=
EXPO_PUBLIC_OFFLINE_MAP_CORRIDOR_KM=5
EXPO_PUBLIC_OFFLINE_MAP_SEGMENT_KM=20
EXPO_PUBLIC_OFFLINE_MAP_MIN_ZOOM=9
EXPO_PUBLIC_OFFLINE_MAP_MAX_ZOOM=16
EXPO_PUBLIC_OFFLINE_MAP_TILE_LIMIT=30000
EXPO_PUBLIC_OFFLINE_MAP_ESTIMATED_TILE_KB=25
EXPO_PUBLIC_OFFLINE_MAP_MIN_FREE_MB=250
