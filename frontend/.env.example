# Export web con Docker/Nginx: usa el proxy interno, sin IP fija.
EXPO_PUBLIC_API_URL=/api

# Para Expo Go o un APK nativo, reemplaza /api por una URL alcanzable desde
# el teléfono, por ejemplo http://192.168.1.20:8000 o https://api.midominio.com.
# Un APK de producción debe usar HTTPS estable; no localhost ni un túnel temporal.

# Vacío usa temporalmente el demo público de OSRM. En móvil/LAN usa una URL
# alcanzable mediante el proxy, por ejemplo http://192.168.1.20:8080/osrm. En
# Docker web usa /osrm. No expongas directamente el puerto interno 5000.
EXPO_PUBLIC_OSRM_URL=
