{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://coffee-fly.hostless.app/api",
        "EXPO_PUBLIC_APP_URL": "https://coffee-fly.hostless.app",
        "EXPO_PUBLIC_NATIVE_APP": "false",
        "EXPO_PUBLIC_OFFLINE_MAP_STYLE_URL": "https://coffee-fly.hostless.app/maps/styles/coffee-fly/style.json"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://coffee-fly.hostless.app/api",
        "EXPO_PUBLIC_APP_URL": "https://coffee-fly.hostless.app",
        "EXPO_PUBLIC_NATIVE_APP": "false",
        "EXPO_PUBLIC_OFFLINE_MAP_STYLE_URL": "https://coffee-fly.hostless.app/maps/styles/coffee-fly/style.json"
      }
    }
  }
}
