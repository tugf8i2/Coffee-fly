ENV=development
DATABASE_URL=postgresql://postgres:1234@127.0.0.1:5433/coffeefly
JWT_SECRET_KEY=GENERA_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ALLOWED_HOSTS=localhost,127.0.0.1,api.tudominio.com
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
