      "source": "coffee-fly-colombia",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track", "path"]]],
      "paint": {
        "line-color": "#9f9588",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 10, 2.2, 14, 6.5]
      }
    },
    {
      "id": "vias",
      "type": "line",
      "source": "coffee-fly-colombia",
      "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track", "path"]]],
      "paint": {
        "line-color": ["match", ["get", "class"], ["motorway", "trunk"], "#efb36e", ["primary", "secondary"], "#f6d49a", ["track", "path"], "#eee4d3", "#ffffff"],
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.35, 10, 1.4, 14, 4.6]
      }
    },
    {
      "id": "nombres-vias",
      "type": "symbol",
      "source": "coffee-fly-colombia",
